# Postgres. `docker compose up -d db`
DATABASE_URL=postgres://ootd:ootd@localhost:5433/ootd

# Originals and cutouts on disk. Not in git.
STORAGE_ROOT=./storage

# Cutout provider for every new photo: local (BiRefNet: far better edges,
# ~30-40s on CPU, weights download on first use; the compose worker has it),
# chroma (instant colour key, no model; fails on garments close to the
# floor's colour), or replicate (needs REPLICATE_API_TOKEN).
CUTOUT_PROVIDER=local
# REPLICATE_API_TOKEN=

# The marker rig, measured circle centre to circle centre in mm. Print the
# four pages from /sheet at 100% and measure what you taped down. Four sides
# plus the ID 0 to ID 2 diagonal are required; the second diagonal is an
# optional cross-check. These are placeholders for an 800 x 1000 rig.
NEXT_PUBLIC_SHEET_TOP_MM=670
NEXT_PUBLIC_SHEET_RIGHT_MM=864
NEXT_PUBLIC_SHEET_BOTTOM_MM=670
NEXT_PUBLIC_SHEET_LEFT_MM=864
NEXT_PUBLIC_SHEET_DIAG_MM=1093.3
# NEXT_PUBLIC_SHEET_DIAG2_MM=1093.3

# What the black square on a printed page actually measures. Meant to be 88;
# set the real number if your printer scaled. Unset assumes a perfect print.
NEXT_PUBLIC_SHEET_BLACK_SQUARE_MM=88

# Hosted image generation (the standardisation bake-off, then production).
# fal.ai dashboard, Keys. Never commit a real key.
# FAL_KEY=
